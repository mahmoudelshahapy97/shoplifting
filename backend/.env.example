# =============================================================================
# APPLICATION
# =============================================================================
APP_NAME="Shoplifting API"
APP_DESCRIPTION="Pose-based shoplifting detection, incident triage and loss analytics"
APP_VERSION="1.0.0"
APP_API_PREFIX="/api/v1"
APP_HOST="0.0.0.0"
APP_PORT=8000
APP_DEBUG=true
ENVIRONMENT=development

PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

# =============================================================================
# CORS
# =============================================================================
# The console reaches the API through a same-origin proxy (Vite in dev, nginx
# in the container), so CORS is not normally involved. These cover the case of
# a browser pointed straight at the API host.
CORS_ORIGINS='["http://localhost:5173","http://localhost:8083","http://localhost:8004"]'
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS='["GET","POST","PUT","PATCH","DELETE"]'
CORS_ALLOW_HEADERS='["Content-Type","Authorization","X-Request-ID"]'

# =============================================================================
# AUTH
# =============================================================================
# Required -- the app refuses to start without it. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY="generate-your-own-see-comment-above"
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Set true once served over HTTPS.
AUTH_COOKIE_NAME=sl_access
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

# There is no public signup. This account is created once, when app_user is
# empty at startup. Change the password after first login.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@insighteye.local
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe!123

# "Forgot your password?" mails a 6-digit code to the account's email. It is
# off (the link is hidden) until SMTP_HOST is set below.
OTP_TTL_SECONDS=600
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5

# =============================================================================
# EMAIL (SMTP) -- only used for password-reset codes
# =============================================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM="Shoplifting <no-reply@insighteye.local>"
# STARTTLS on 587; set SMTP_SSL=true (and SMTP_STARTTLS=false) for port 465.
SMTP_STARTTLS=true
SMTP_SSL=false

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=INFO
LOG_FORMAT="%(asctime)s - %(name)s - %(levelname)s - %(message)s"
LOG_FILE_PATH="logs/shoplifting.log"

# =============================================================================
# DATABASE (POSTGRES)
# =============================================================================
POSTGRES_DB="shoplifting_db"
POSTGRES_USER="shoplifting"
POSTGRES_PASSWORD="shoplifting_pass"
DB_HOST="db"
DB_PORT=5432

DB_MIN_POOL_SIZE=2
DB_MAX_POOL_SIZE=10
DB_TIMEOUT=30.0
DB_COMMAND_TIMEOUT=60.0
DB_MAX_RETRIES=10
DB_RETRY_DELAY_BASE=2
DB_RETRY_DELAY_MAX=30

# =============================================================================
# MODELS
# =============================================================================
YOLO_CONFIG_DIR="/app/.ultralytics"
MODEL_DEVICE=cuda

# People and their 17 keypoints, tracked so each person is judged alone.
POSE_MODEL_PATH="models/yolo26m-pose.pt"
POSE_CONFIDENCE=0.25
POSE_INPUT_SIZE=640
POSE_TRACKER="trackers/shoplifting_bytetrack.yaml"
# FP16 on CUDA.
POSE_HALF=true
# InsightEye's temporal classifier (Conv1d + BiGRU + attention), 120 x 17 x 12.
CLASSIFIER_MODEL_PATH="models/shoplifting.pt"

# =============================================================================
# SHOPLIFTING DETECTOR
# =============================================================================
# Samples per second in each person's 120-sample window (3 fps = 40 s window,
# InsightEye's rate; see tools/eval_shoplifting.py before changing it)
SAMPLE_FPS=3.0
# Smoothed probability that raises an alert (InsightEye's .env uses 0.15)
SHOPLIFTING_THRESHOLD=0.5
# Judgements averaged into the smoothed probability
SMOOTH_WINDOW=3
# People shorter than this many pixels are not judged
MIN_PERSON_HEIGHT_PX=60
# One alert per person per N seconds, and one per camera across people
TRACK_COOLDOWN_SECONDS=300
CAMERA_COOLDOWN_SECONDS=30
# Processed frames a person may be missing before their session ends
TRACK_MAX_MISSES=15
# A new tracker id this soon after a person vanished, at a similar size,
# continues their window - bridges id switches (0 = never)
TRACK_HANDOVER_SECONDS=5.0
# Real samples of a person before they are first judged (30 = 10 s at 3 fps);
# the rest of the window is padded with empty rows, as InsightEye's buffer was
MIN_WINDOW_SAMPLES=30
# Peak probability -> severity
SEVERITY_CRITICAL=0.9
SEVERITY_HIGH=0.75
SEVERITY_MEDIUM=0.6
# One probability sample per person this often (model audit, real-time monitor)
OBSERVATION_INTERVAL_S=5


# =============================================================================
# RTSP / STREAM
# =============================================================================
RTSP_TRANSPORT=tcp
RTSP_BUFFER_SIZE=1
RTSP_OPEN_TIMEOUT=15.0
RTSP_READ_FAILURE_LIMIT=30
RTSP_RECONNECT_DELAY_BASE=2.0
RTSP_RECONNECT_DELAY_MAX=30.0

# Process 1 out of every N decoded frames (at least; the reader keeps to the live edge)
FRAME_SKIP=5
# Match SAMPLE_FPS: every processed frame is one sample
TARGET_PROCESS_FPS=3.0
JPEG_QUALITY=85

STREAM_START_STAGGER_DELAY=2.0
STREAM_WORKER_RESTART_DELAY=5.0

# Concurrent MJPEG live viewers across all cameras
MAX_MJPEG_CLIENTS=4

# =============================================================================
# WORKER SUPERVISION
# =============================================================================
# Restart dead, errored or stalled workers; start enabled cameras with no worker
WORKER_SUPERVISION_ENABLED=true
WORKER_SUPERVISION_INTERVAL_S=15.0
WORKER_RESTART_BACKOFF_BASE_S=5.0
WORKER_RESTART_BACKOFF_MAX_S=300.0

# =============================================================================
# EVIDENCE CLIPS
# =============================================================================
# Annotated mp4 per incident: CLIP_PRE_SECONDS before the alert, CLIP_POST_SECONDS after.
CLIP_ENABLED=true
CLIP_DIR="data/clips"
CLIP_PRE_SECONDS=20.0
CLIP_POST_SECONDS=10.0
CLIP_MAX_WIDTH=960
CLIP_JPEG_QUALITY=70

# =============================================================================
# RETENTION
# =============================================================================
RETENTION_ENABLED=true
RETENTION_INTERVAL_S=21600
CLIP_RETENTION_DAYS=30
CLIP_MAX_TOTAL_MB=5120
OBSERVATION_RETENTION_DAYS=30

# =============================================================================
# OBJECT STORAGE (MinIO)
# =============================================================================
# Images and videos go to MinIO; Postgres keeps the records and object keys.
# docker-compose sets these for the api from the root .env. Leave the endpoint
# empty to keep media in Postgres / on disk.
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=shoplifting
MINIO_SECURE=false
