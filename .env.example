# Root .env: read by docker-compose.yml. Copy to .env and fill in.

# Host ports for this stack (the defaults sit next to the other feature stacks).
WEB_HOST_PORT=8083
API_HOST_PORT=8004
POSTGRES_HOST_PORT=5437
RTSP_HOST_PORT=8557
MINIO_API_HOST_PORT=9002
MINIO_CONSOLE_HOST_PORT=9003

# MinIO (object storage for incident frames and clips). The console logs in
# with these; the api is given them by docker-compose.yml.
MINIO_ROOT_USER=shoplifting
MINIO_ROOT_PASSWORD=change-me-to-a-long-random-string
MINIO_BUCKET=shoplifting
