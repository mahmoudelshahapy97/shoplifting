# Where the Vite dev server proxies /api and /health.
#
# The API listens on 8000 in its container; docker-compose.yml publishes it on
# 8004 so the stack coexists with the other feature stacks on this machine.
VITE_API_TARGET=http://127.0.0.1:8004

# Dev-server port. The e2e suite and the README both assume 5173.
VITE_PORT=5173
VITE_PREVIEW_PORT=4173
