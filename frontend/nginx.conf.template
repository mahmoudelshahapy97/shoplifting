# Production counterpart of the Vite dev proxy in vite.config.js.
#
# Same contract: the browser only ever talks to this origin, nginx forwards
# /api, /health and FastAPI's own /docs to the API. Keep the two files in step --
# a path proxied in dev but not here is a 404 that only shows up after a build.
#
# Rendered by envsubst at container start (see the Dockerfile), so ${SL_API_URL}
# comes from the environment rather than being baked into the image.

server {
    listen       80;
    server_name  _;

    root  /usr/share/nginx/html;
    index index.html;

    proxy_http_version 1.1;
    # A cold API is loading YOLO and CLIP; the first snapshot can take a while.
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;

    # Nothing here uploads files; JSON bodies stay small. Kept above nginx's
    # 1 MB default so a long incident note never meets a bare 413.
    client_max_body_size 2m;

    # The SPA owns its routes: /events/<uuid> is React Router's, not a file.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Hashed asset filenames: safe to cache hard. index.html must never be
    # cached, or a deploy leaves browsers pointing at assets that are gone.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location = /index.html {
        add_header Cache-Control "no-store";
    }

    # MJPEG live view: an endless multipart response. Buffered, nginx would
    # hold frames back until its buffer filled and the view would stutter.
    location ~ ^/api/v1/cameras/[^/]+/stream$ {
        proxy_pass        ${SL_API_URL};
        proxy_buffering   off;
        proxy_cache       off;
        proxy_read_timeout 1h;
        proxy_set_header  Host              $host;
        proxy_set_header  X-Real-IP         $remote_addr;
        proxy_set_header  X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header  X-Forwarded-Proto $scheme;
    }

    location /api/ {
        proxy_pass       ${SL_API_URL};
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # The probe the health badge polls, mounted outside the versioned prefix.
    location = /health {
        proxy_pass       ${SL_API_URL};
        proxy_set_header Host $host;
    }

    location /docs {
        proxy_pass       ${SL_API_URL};
        proxy_set_header Host $host;
    }

    location /redoc {
        proxy_pass       ${SL_API_URL};
        proxy_set_header Host $host;
    }

    location = /openapi.json {
        proxy_pass       ${SL_API_URL};
        proxy_set_header Host $host;
    }

    gzip              on;
    gzip_types        text/css application/javascript application/json image/svg+xml;
    gzip_min_length   1024;
}
